{
  "schema": 1,
  "cases": [
    {
      "input": "Sopeek-1.0.0-alpha.6_win10_win11_x64_Setup.exe",
      "expected": "Sopeek-1.0.0-alpha.6_win10_win11_x64_Setup.exe",
      "note": "plain asset name"
    },
    {
      "input": "../../evil.exe",
      "expected": "evil.exe",
      "note": "basename only; traversal is rejected by dest_path validation"
    },
    {
      "input": "C:\\Temp\\Foo Setup.exe",
      "expected": "Foo Setup.exe",
      "note": "windows basename"
    },
    {
      "input": "dir/sub/App.exe",
      "expected": "App.exe",
      "note": "posix basename"
    },
    {
      "input": "CON.exe",
      "expected": null,
      "note": "reserved CON"
    },
    {
      "input": "con.exe",
      "expected": null,
      "note": "reserved case-insensitive"
    },
    {
      "input": "LPT9.exe",
      "expected": null,
      "note": "reserved LPT9"
    },
    {
      "input": "COM10.exe",
      "expected": "COM10.exe",
      "note": "COM10 is not reserved"
    },
    {
      "input": "Aux.tar.exe",
      "expected": null,
      "note": "reserved stem before extension"
    },
    {
      "input": "name.exe.",
      "expected": "name.exe",
      "note": "trailing dot stripped"
    },
    {
      "input": "name.exe   ",
      "expected": "name.exe",
      "note": "trailing spaces stripped"
    },
    {
      "input": "bad<>:\"|?*name.exe",
      "expected": "badname.exe",
      "note": "illegal characters removed"
    },
    {
      "input": "bad\u0001name.exe",
      "expected": "badname.exe",
      "note": "control character removed"
    },
    {
